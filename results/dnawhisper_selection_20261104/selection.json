    "deviations": [
      {
        "item": "optimizer and learning rate",
        "official_yaml": "optimizer.type: lion, learning_rate: 1.0e-5, weight_decay: 1.0e-5",
        "effective": "AdamW lr 1.0e-4 weight_decay 1.0e-2 (upstream reads optimizer.name and optimizer.params.lr; the shipped keys are ignored and no lion branch exists)",
        "decision": "reproduce the effective released behaviour and record the paper-stated settings here"
      },
      {
        "item": "cosine schedule",
        "official_yaml": "scheduler.cosine.t_max: 100",
        "effective": "T_max falls back to trainer.estimated_stepping_batches, interval=step, eta_min=0",
        "decision": "keep upstream fallback"
      },
      {
        "item": "pretraining objective",
        "official_yaml": "primary_loss.enabled: false plus PWCosSim",
        "effective": "primary_loss.enabled is never read; supervised MSE is always added, and the PWCosSim target is built from phenotypes",
        "decision": "restrict pretraining to the current fitting subset and report it as in-training supervised pretraining"
      },
      {
        "item": "phenotype standardization",
        "official_yaml": "statistics computed over all 599 lines before splitting; released wheatY.csv is already standardized over all lines",
        "effective": "per-environment mean and standard deviation fitted on the current fitting subset only; predictions inverse-transformed before metrics",
        "decision": "project CV1 requirement"
      },
      {
        "item": "data partition",
        "official_yaml": "internal np.random.shuffle split, use_cv_folds: false, train/val/test ratios",
        "effective": "material splits come from results/get_icm_protocol_20261103/splits_manifest.json; inner three folds for epoch selection, full development refit, single test pass",
        "decision": "project CV1 requirement"
      },
      {
        "item": "batch dropping",
        "official_yaml": "DataLoader(drop_last=True)",
        "effective": "drop_last=false for train, validation and prediction so no material is dropped",
        "decision": "fixed by the lead on 2026-11-03"
      },
      {
        "item": "devices and precision",
        "official_yaml": "accelerator: gpu, devices: [0, 1], precision: bf16-mixed",
        "effective": "single device, per-process memory fraction 0.35; bf16-mixed retained, switching to 32-true would be logged as a further deviation",
        "decision": "shared GPU rules"
      },
      {
        "item": "validation metric owner",
        "official_yaml": "ModelCheckpoint/EarlyStopping monitor val_pearson_corr_epoch, logged by the upstream module hook",
        "effective": "the adapter callback collects validation batches and computes per-environment PCC itself, because Lightning calls callback hooks before the module hook (one-epoch lag) and because upstream silently omits any environment with constant predictions from the average",
        "decision": "project rule against filtering failures; constant or non-finite environment raises instead of being dropped"
      },
      {
        "item": "checkpoint and early stopping",
        "official_yaml": "ModelCheckpoint save_top_k 3 and EarlyStopping patience 15 on val_pearson_corr_epoch",
        "effective": "the full 100-epoch curve is recorded for every inner unit; refit stops at the selected epoch while retaining the full 100-epoch cosine schedule horizon",
        "decision": "project selection rule"
      },
      {
        "item": "upstream checkout form",
        "official_yaml": "git repository at the pinned commit",
        "effective": "archive extracted from codeload for 7a657cc; integrity by git blob hash of each required file against the pinned tree, because the partial-clone blob fetch did not complete on this link",
        "decision": "verification is content-based and recorded in provenance.json"
      },
      {
        "item": "attention backend at 1279 markers",
        "official_yaml": "attention type flash_attention; mlenv.yml installs flash-attn",
        "effective": "flash-attn 2.8.3.post2 (+cu12, torch 2.7, cp312) installed into the read-only overlay. With it importable the upstream factory selects the FlashAttention class; its own kernels reject the dtypes used here and fall back at run time (24 fallback warnings in the 2-epoch probe) to a manual masked attention that stays finite. Without it the factory builds StandardAttention, whose nn.MultiheadAttention returns NaN for the fully masked remainder chunk because 1279 = 19*64 + 63. NaN is precision- and device-independent (bf16-mixed and 32-true, CPU and CUDA), and 1216/1280/1344 markers are finite, so the published marker count is unusable on the no-flash_attn branch but the attention mathematics is standard in both cases",
        "decision": "keep the upstream attention configuration and supply the package it assumes; NaN is precision- and device-independent, so it is not a bf16 or GPU defect"
      },
      {
        "item": "pretrained weights",
        "official_yaml": "none published (no release, no tag, no checkpoint in the repository or on Hugging Face)",
        "effective": "every stage is trained from the pinned code in this project environment",
        "decision": "required for reproduction"
      },
      {
        "item": "python and torch build",
        "official_yaml": "mlenv.yml python 3.10 with torch 2.8.0+cu128; environment.yml is an unrelated cpu export (cropformer, torch 2.5.1)",
        "effective": "reuse of boltz2 (python 3.12.15, torch 2.7.1+cu128) with an overlay supplying entmax and flash-attn; torch is one minor version behind upstream mlenv",
        "decision": "shared environments are not modified; xformers, Pgenlib, mamba, lion-pytorch and pot are absent on this execution path"
      }
    ]
  },
